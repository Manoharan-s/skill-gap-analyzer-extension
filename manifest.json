{
  "manifest_version":3,
  "name":"Skill Gap Analyser",
  "version":"1.0",
   "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "description":"Compare Skills With LinkedIn Jobs",
  "permissions":["activeTab","tabs","storage"],
  "host_permissions":[
    "<all_urls>"
  ],
   "action": {
    "default_popup": "popup.html",
    "default_icon": {
        "16": "icons/16.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    }
},
  "content_scripts":[{
    "matches":["<all_urls>"],
     "js": ["content.js"]
  }]






}